# Optional local-only updater token for testing private GitHub Releases.
# Do not ship production builds with this set.
VITE_GITHUB_UPDATER_TOKEN=

# Repository used to generate the updater endpoint for `pnpm tauri dev/build`.
# GitHub Actions already provides GITHUB_REPOSITORY, so this is mainly local.
GHWTDE_UPDATER_REPOSITORY=HolKowa/GhwtdeIniLoader
