# Repository used to generate the public GitHub Releases updater endpoint.
# GitHub Actions provides GITHUB_REPOSITORY automatically, so this is mainly local.
GHWTDE_UPDATER_REPOSITORY=HolKowa/GhwtdeIniLoader

# Local-only updater endpoint override for testing signed Linux update fixtures.
# Generate it with `pnpm updater:build-linux 99.0.0`, then run `pnpm tauri dev`.
# GHWTDE_UPDATER_ENDPOINT=http://localhost:1420/updater-local/latest.json

# Local-only app version override for testing update availability.
# Set lower than latest.json's version to make the updater report an update.
# GHWTDE_APP_VERSION=0.0.0

# Local-only signing values used by `pnpm updater:build-linux <version>`.
# Never commit real signing secrets.
# TAURI_SIGNING_PRIVATE_KEY="your private key here"
# TAURI_SIGNING_PRIVATE_KEY_PASSWORD="your private key password here"
